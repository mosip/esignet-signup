{
  "slotId": "{{slotId}}",
  "idvSlotAllotted": "{{idvSlotAllotted}}",
  "sendDestination": "{{sendDestination}}",
  "message1": {
    "slotId": "{{slotId}}",
    "stepCode": "START",
    "frames": [
      {{#each message1.frames}}
      { "frame": "{{this.frame}}", "order": "{{this.order}}" }{{#unless @last}},{{/unless}}
      {{/each}}
    ]
  },
  "message2": {
    "slotId": "{{slotId}}",
    "stepCode": "liveness_check",
    "frames": [
      {{#each message2.frames}}
      { "frame": "{{this.frame}}", "order": "{{this.order}}" }{{#unless @last}},{{/unless}}
      {{/each}}
    ]
  },
  "steps": [
    {{#each steps}}
    {
      "rawMessage": {{json this.rawMessage}},
      "expectedFeedbackCodes": {{json this.expectedFeedbackCodes}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ]
}
